rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'divijbajaj5@gmail.com'
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isBoundedString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isBoundedStringList(arr, minItems, maxItems) {
      return arr is list
        && arr.size() >= minItems
        && arr.size() <= maxItems
        && arr[0] is string
        && arr[0].size() <= 200;
    }

    function isValidSurveyResponse(data) {
      return data.keys().hasAll([
          'q1Team', 'q1TeamOther', 'q2Role', 'q3Frequency',
          'q4Tools', 'q4ToolsOther', 'q5Accounts',
          'q6UseCases', 'q6UseCasesOther', 'q7HelpfulTask',
          'q8Confidence', 'q9Techniques', 'q10MarketShareQuestion',
          'q11OutputChecks', 'q11OutputChecksOther',
          'q12Blockers', 'q12BlockersOther', 'q13RepetitiveTask',
          'q14WorkshopGoals', 'q14WorkshopGoalsOther',
          'source', 'createdAt'
        ])
        && data.keys().hasOnly([
          'q1Team', 'q1TeamOther', 'q2Role', 'q3Frequency',
          'q4Tools', 'q4ToolsOther', 'q5Accounts',
          'q6UseCases', 'q6UseCasesOther', 'q7HelpfulTask',
          'q8Confidence', 'q9Techniques', 'q10MarketShareQuestion',
          'q11OutputChecks', 'q11OutputChecksOther',
          'q12Blockers', 'q12BlockersOther', 'q13RepetitiveTask',
          'q14WorkshopGoals', 'q14WorkshopGoalsOther',
          'source', 'createdAt'
        ])
        && isBoundedString(data.q1Team, 1, 120)
        && isBoundedString(data.q1TeamOther, 0, 200)
        && isBoundedString(data.q2Role, 1, 120)
        && isBoundedString(data.q3Frequency, 1, 120)
        && isBoundedStringList(data.q4Tools, 1, 10)
        && isBoundedString(data.q4ToolsOther, 0, 200)
        && isBoundedString(data.q5Accounts, 1, 160)
        && isBoundedStringList(data.q6UseCases, 1, 12)
        && isBoundedString(data.q6UseCasesOther, 0, 200)
        && isBoundedString(data.q7HelpfulTask, 0, 3000)
        && data.q8Confidence is int && data.q8Confidence >= 1 && data.q8Confidence <= 5
        && isBoundedStringList(data.q9Techniques, 1, 10)
        && isBoundedString(data.q10MarketShareQuestion, 1, 240)
        && isBoundedStringList(data.q11OutputChecks, 1, 8)
        && isBoundedString(data.q11OutputChecksOther, 0, 200)
        && isBoundedStringList(data.q12Blockers, 1, 3)
        && isBoundedString(data.q12BlockersOther, 0, 200)
        && isBoundedString(data.q13RepetitiveTask, 1, 3000)
        && isBoundedStringList(data.q14WorkshopGoals, 1, 10)
        && isBoundedString(data.q14WorkshopGoalsOther, 0, 200)
        && isBoundedString(data.source, 1, 60)
        && data.createdAt == request.time;
    }

    function isValidConsultationRequest(data) {
      return data.keys().hasAll(['fullName', 'workEmail', 'company', 'teamSize', 'painPoints', 'createdAt'])
        && data.keys().hasOnly(['fullName', 'workEmail', 'company', 'teamSize', 'painPoints', 'createdAt'])
        && isBoundedString(data.fullName, 2, 120)
        && isBoundedString(data.workEmail, 5, 160)
        && data.workEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && isBoundedString(data.company, 1, 160)
        && isBoundedString(data.teamSize, 1, 60)
        && isBoundedString(data.painPoints, 5, 3000)
        && data.createdAt == request.time;
    }

    function isValidSpreadsheetSettings(data) {
      return data.keys().hasAll(['spreadsheetId', 'spreadsheetTitle', 'spreadsheetUrl', 'syncedCount', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['spreadsheetId', 'spreadsheetTitle', 'spreadsheetUrl', 'syncedCount', 'updatedBy', 'updatedAt'])
        && isBoundedString(data.spreadsheetId, 5, 200)
        && isBoundedString(data.spreadsheetTitle, 1, 200)
        && isBoundedString(data.spreadsheetUrl, 10, 500)
        && data.syncedCount is int && data.syncedCount >= 0 && data.syncedCount <= 100000
        && isBoundedString(data.updatedBy, 1, 160)
        && data.updatedAt == request.time;
    }

    match /survey_responses/{responseId} {
      allow create: if isValidId(responseId) && isValidSurveyResponse(incoming());
      allow get: if isAdmin() && isValidId(responseId);
      allow list: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin() && isValidId(responseId);
    }

    match /consultation_requests/{requestId} {
      allow create: if isValidId(requestId) && isValidConsultationRequest(incoming());
      allow get: if isAdmin() && isValidId(requestId);
      allow list: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin() && isValidId(requestId);
    }

    match /settings/{settingId} {
      allow get: if isAdmin() && isValidId(settingId);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(settingId) && isValidSpreadsheetSettings(incoming());
      allow delete: if isAdmin() && isValidId(settingId);
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId && isValidId(adminId);
      allow list, write: if false;
    }
  }
}
